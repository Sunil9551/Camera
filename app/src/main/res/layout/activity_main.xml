<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top bar: timer in the middle, settings on the right. Fixed height, no hard-coded status-bar offset
         (system bar / notch space is added in code from the real window insets). -->
    <LinearLayout
        android:id="@+id/recordingStatusLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- One fixed slot (14dp + 6dp gap) shared by the red dot and the pause icon.
             Only one of them is visible at a time, and the slot never changes size,
             so the timer stays exactly in the same place while recording and while paused. -->
        <FrameLayout
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/redBlinkingDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_red"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgPauseIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause_indicator"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Hidden until a recording starts (code shows it). INVISIBLE keeps its space. -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOTO"
            android:textColor="#FF0000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/recordingStatusLayout"
        app:layout_constraintBottom_toBottomOf="@id/recordingStatusLayout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Viewfinder: takes the biggest area that fits BETWEEN the top bar and the middle band
         (mode switch + zoom), always keeping the camera's own aspect ratio (set from code).
         So it never overlaps the controls and never stretches, whatever the screen height is. -->
    <TextureView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toBottomOf="@id/recordingStatusLayout"
        app:layout_constraintBottom_toTopOf="@id/middleBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Highest top edge of the Photo/Video switch and the zoom buttons: the viewfinder always stops above it. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/middleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="modeCapsule,zoomLayout" />

    <!-- Zoom buttons: same place as before (right side, above the record row), same look. -->
    <LinearLayout
        android:id="@+id/zoomLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsLayout">

        <Button
            android:id="@+id/btnZoomIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/btnZoomOut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Photo / Video switch: centered on the screen, vertically in the middle of the zoom buttons. -->
    <LinearLayout
        android:id="@+id/modeCapsule"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/mode_capsule"
        app:layout_constraintTop_toTopOf="@id/zoomLayout"
        app:layout_constraintBottom_toBottomOf="@id/zoomLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnPhotoMode"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Photo"
            android:textColor="@color/mode_text_selector"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/mode_tab_selector" />

        <TextView
            android:id="@+id/btnVideoMode"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Video"
            android:textColor="@color/mode_text_selector"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/mode_tab_selector" />
    </LinearLayout>

    <!-- Bottom row, pinned to the bottom edge. Record is always exactly centered.
         Stop sits in the gap between Switch-camera and Record, so nothing can overlap on narrow phones. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Take photo or start recording"
            android:background="@drawable/circle_red"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnSwitchCam"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Switch camera"
            android:src="@drawable/ic_camera_switch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/btnRecord"
            app:layout_constraintBottom_toBottomOf="@id/btnRecord"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Stop recording"
            android:visibility="gone"
            android:src="@drawable/ic_stop"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="@id/btnRecord"
            app:layout_constraintBottom_toBottomOf="@id/btnRecord"
            app:layout_constraintStart_toEndOf="@id/btnSwitchCam"
            app:layout_constraintEnd_toStartOf="@id/btnRecord" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Flash"
            android:src="@drawable/ic_flash"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/btnRecord"
            app:layout_constraintBottom_toBottomOf="@id/btnRecord"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
