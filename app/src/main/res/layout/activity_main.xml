<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- ===== TOP APP BAR : gradient strip ===== -->
        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/top_bar_gradient"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_launcher"
                android:contentDescription="App icon" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="Camera"
                android:textColor="#000000"
                android:textSize="33sp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="33sp"
                android:fontFamily="@font/delicatusmedium" />

            <!-- Right side ke barabar spacing ke liye, icon ke jitni width -->
            <View
                android:layout_width="44dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <!-- ===== SETTINGS GEAR : header strip ke theek neeche ===== -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:padding="6dp"
            app:tint="#757575"
            android:contentDescription="Settings"
            app:layout_constraintTop_toBottomOf="@+id/topAppBar"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== VIEWFINDER : hamesha 4:3, dono mode me full FOV ===== -->
        <androidx.camera.view.PreviewView
    android:id="@+id/viewFinder"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:rotation="270"
    app:scaleType="fitCenter"
    app:layout_constraintDimensionRatio="3:4"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/btnSettings"
    app:layout_constraintBottom_toTopOf="@+id/modeToggleContainer" />



        <!-- ===== MODE TOGGLE : Camera / Video, viewfinder ke theek neeche ===== -->
        <LinearLayout
            android:id="@+id/modeToggleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/toggle_pill_bg"
            android:padding="4dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@+id/viewFinder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/timerLayout">

            <TextView
                android:id="@+id/tvModeCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Camera"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/toggle_selected_bg"
                android:fontFamily="@font/delicatusmedium"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Video"
                android:textColor="#000000"
                android:textSize="14sp"
                android:fontFamily="@font/delicatusmedium"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ===== TIMER : recording ke dauraan hi visible ===== -->
        <LinearLayout
            android:id="@+id/timerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@+id/modeToggleContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/controlsLayout">

            <View
                android:id="@+id/vRedDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/red_dot"
                android:layout_marginEnd="8dp" />

            <com.camera.app.SevenSegmentTextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Recording timer" />

        </LinearLayout>

        <!-- ===== ZOOM CONTROLS : dono mode me, right side, + upar - neeche ===== -->
        <LinearLayout
            android:id="@+id/zoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@+id/modeToggleContainer"
            app:layout_constraintBottom_toBottomOf="@+id/modeToggleContainer"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="20dp">

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_zoom_in"
                android:padding="4dp"
                android:contentDescription="Zoom in" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_zoom_out"
                android:padding="4dp"
                android:contentDescription="Zoom out" />

        </LinearLayout>

        <!-- ===== BOTTOM CONTROLS ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="28dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_camera_switch"
                android:padding="12dp"
                android:contentDescription="Camera switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="36dp" />

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_stop"
                android:padding="8dp"
                android:contentDescription="Stop"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btnRecord"
                android:layout_marginBottom="10dp" />

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/record_button_bg"
                android:contentDescription="Capture"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_flash_off"
                android:padding="12dp"
                android:contentDescription="Flash"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="36dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
